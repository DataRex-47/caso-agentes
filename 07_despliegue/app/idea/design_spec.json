{
    "app": {
        "name": "scoring_contratacion_fondos",
        "version": 2,
        "framework": "streamlit",
        "title": "Scoring de contratación de fondos",
        "description": "Identifica clientes con mayor probabilidad de contratación",
        "logo": {
            "type": "image",
            "key": "logo_scoring",
            "position": "header_right",
            "placeholder": true
        },
        "layout": {
            "type": "vertical",
            "shell": "entrada en sidebar + panel central de resultados",
            "sections": [
                {
                    "id": "header",
                    "type": "header",
                    "layout": "columns",
                    "columns": [
                        {
                            "width": 2,
                            "components": [
                                {
                                    "type": "title",
                                    "text": "Scoring de contratación de fondos"
                                },
                                {
                                    "type": "markdown",
                                    "text": "Identifica clientes con mayor probabilidad de contratación"
                                }
                            ]
                        },
                        {
                            "width": 1,
                            "components": [
                                {
                                    "type": "image",
                                    "key": "logo_scoring",
                                    "label": "Logo scoring"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "input_sidebar",
                    "type": "sidebar_form",
                    "title": "Parámetros del cliente",
                    "form_key": "parametros_entrada_form",
                    "layout": "vertical_groups",
                    "groups": [
                        "Datos personales",
                        "Productos y estado",
                        "Contacto y campaña",
                        "Historial de campañas",
                        "Entorno económico"
                    ],
                    "components": [
                        {
                            "type": "note",
                            "text": "Los 15 campos reales se derivan del contrato de la API (api/schemas.py) y se agrupan por bloques temáticos en el sidebar."
                        }
                    ],
                    "actions": [
                        {
                            "id": "calcular_resultado",
                            "type": "button",
                            "label": "Resultado"
                        }
                    ]
                },
                {
                    "id": "result_section",
                    "type": "result_section",
                    "title": "Resultado",
                    "layout": "columns",
                    "columns": [
                        {
                            "width": 3,
                            "components": [
                                {
                                    "id": "score_gauge",
                                    "type": "gauge_chart",
                                    "label": "Velocímetro de scoring",
                                    "min": 0,
                                    "max": 100,
                                    "zones": [
                                        "baja (<40)",
                                        "media (40-70)",
                                        "alta (>=70)"
                                    ],
                                    "needle": true,
                                    "animated": true
                                }
                            ]
                        },
                        {
                            "width": 2,
                            "components": [
                                {
                                    "id": "score_interpretation",
                                    "type": "text",
                                    "label": "Lectura del resultado",
                                    "value": "mensaje de negocio según la categoría real de la API (ALTA/MEDIA/BAJA_PROBABILIDAD)"
                                },
                                {
                                    "id": "score_prediction",
                                    "type": "caption",
                                    "label": "Predicción del modelo",
                                    "value": "contratará / no contratará"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}